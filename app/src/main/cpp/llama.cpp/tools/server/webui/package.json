{
	"name": "webui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"build": "vite build && ./scripts/post-build.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"reset": "rm -rf .svelte-kit node_modules",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "npm run test:ui -- --run && npm run test:client -- --run && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:client": "vitest --project=client",
		"test:unit": "vitest --project=unit",
		"test:ui": "vitest --project=ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"cleanup": "rm -rf .svelte-kit build node_modules test-results"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.30.0",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.6.3",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.6.3",
		"@storybook/sveltekit": "^10.6.3",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"@vitest/browser": "^5.0.5",
		"@vitest/coverage-v8": "^4.1.11",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"dexie": "^4.4.4",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.6",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"http-server": "^14.1.1",
		"mdast": "^3.0.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sass": "^1.102.0",
		"storybook": "^10.6.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.66.0",
		"unified": "^11.0.5",
		"uuid": "^14.0.1",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"highlight.js": "^11.11.1",
		"mode-watcher": "^1.1.0",
		"pdfjs-dist": "^6.2.108",
		"rehype-highlight": "^7.0.2",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"remark-rehype": "^11.1.2",
		"svelte-sonner": "^1.1.1",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.6.6"
	},
	"overrides": {
		"hono": "4.13.16",
		"@hono/node-server": "2.1.3",
		"body-parser": "2.4.0",
		"cookie": "0.7.1",
